# Copiar a .env.development / .env.staging / .env.production según corresponda

MONGO_URI=

# Fintoc — conciliación (no commitear valores reales)
FINTOC_SECRET_KEY=
FINTOC_LINK_TOKEN=
# Múltiples cuentas separadas por coma (reemplaza FINTOC_ACCOUNT_ID)
FINTOC_ACCOUNT_IDS=acc_id1,acc_id2,acc_id3,acc_id4
# Legado — solo si hay una sola cuenta (ignorado si existe FINTOC_ACCOUNT_IDS)
FINTOC_ACCOUNT_ID=

# Importaciones: colecciones Mongo purchaseorders y shipments (misma DB que MONGO_URI)
