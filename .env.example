# Copiar a .env.development / .env.staging / .env.production según corresponda

MONGO_URI=

# Fintoc — conciliación (no commitear valores reales)
FINTOC_SECRET_KEY=
# Un banco = una variable. Nombre libre después de FINTOC_, valor = link_token del banco.
# Al agregar/quitar una variable en Render el banco aparece/desaparece automáticamente.
FINTOC_SANTANDER=link_
FINTOC_BCI=link_
FINTOC_BANCO_ESTADO=link_
FINTOC_BICE=link_

# Importaciones: colecciones Mongo purchaseorders y shipments (misma DB que MONGO_URI)
